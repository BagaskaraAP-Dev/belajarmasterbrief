# Database PostgreSQL
POSTGRES_DB=umkm_db
POSTGRES_USER=umkm_user
POSTGRES_PASSWORD=umkm_password
DATABASE_URL=postgresql://umkm_user:umkm_password@db:5432/umkm_db?schema=public

# Better Auth
BETTER_AUTH_SECRET=example_secret_key_minimum_32_characters_random_string_here
BETTER_AUTH_URL=http://localhost:3000

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WA_NUMBER=6281234567890
DOMAIN=localhost

# Admin Seed
ADMIN_EMAIL=admin@umkm.local
ADMIN_INITIAL_PASSWORD=AdminPassword123!

# Upload
UPLOAD_MAX_MB=5
UPLOAD_DIR=/app/uploads
