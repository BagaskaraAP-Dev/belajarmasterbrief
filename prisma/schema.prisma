generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StoreSetting {
  id          Int      @id @default(1)
  name        String
  tagline     String?
  logoUrl     String?
  address     String?
  mapsEmbed   String?
  waNumber    String
  openHours   String?
  socials     Json     @default("{}")
  heroTitle   String?
  heroText    String?
  updatedAt   DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  sort     Int       @default(0)
  products Product[]
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  price        Int
  comparePrice Int?
  isAvailable  Boolean          @default(true)
  stock        Int?             // null = tidak dilacak
  isFeatured   Boolean          @default(false)
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?        // soft delete

  @@index([categoryId, isAvailable])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String  // relatif terhadap /app/uploads
  alt       String
  width     Int
  height    Int
  sort      Int     @default(0)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String  // mis. "Level pedas 3", "Ukuran L"
  priceDiff Int     @default(0)
}

enum OrderStatus {
  BARU
  DIPROSES
  SELESAI
  BATAL
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // mis. UMK-20261106-0007
  customerName  String
  customerPhone String
  address       String?
  note          String?
  total         Int
  status        OrderStatus @default(BARU)
  items         OrderItem[]
  createdAt     DateTime    @default(now())

  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String  // snapshot
  variantName String?
  unitPrice   Int     // snapshot
  qty         Int
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  content   String
  rating    Int?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    // Markdown
  coverPath   String?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// Better Auth Models
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}
